rules_version = '2';

// Single-owner app: every document this client ever writes lives under
// users/{uid}/... (see src/services/sync.ts — userDoc()/tombstoneDoc()).
// This is the server-side enforcement that the client-side owner-email
// check in src/contexts/AuthContext.tsx cannot provide on its own — it
// stops anyone with a valid Firebase ID token from reading or writing
// another uid's path directly via the SDK or REST API, bypassing the app
// entirely. Without this rule published in the Firebase Console, data
// isolation exists only in the React app, not in the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default (no other top-level collections are
    // used by this app, so nothing legitimate should ever match here).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
